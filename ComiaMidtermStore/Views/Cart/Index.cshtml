@model List<ComiaMidtermStore.Models.CartItem>
@{ ViewData["Title"] = "Cart"; }

<h1>My Cart</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product Name</th><th>Price</th><th>Quantity</th>
            <th>Subtotal</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
             <tr>
                <td>@c.ProductName</td>
                <td>₱@c.Price</td>
                <td>
                    <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="number" name="quantity" value="@c.Quantity" min="1" class="form-control" style="width: 80px;" />
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                    </form>
                </td>
                <td>₱@(c.Price * c.Quantity)</td>
                <td>
                    <a asp-action="Remove" asp-route-id="@c.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Remove this item?')">Remove</a>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th>₱@Model.Sum(c => c.Price * c.Quantity)</th>
            <th></th>
        </tr>
    </tfoot>
</table>

<a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continue Shopping</a>